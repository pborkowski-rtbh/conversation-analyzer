# Environment of local runs against the docker compose stack (make up). No real GCP service is used.
CA_ENV=local
CA_BQ_ENDPOINT=http://localhost:9050
CA_GCS_ENDPOINT=http://localhost:4443
CA_SLACK_API=http://localhost:8088/slack/api
CA_SLACK_TOKEN=xoxb-local
CA_GITHUB_API=http://localhost:8088/github
CA_GITHUB_TOKEN=local
CA_CLOUD_RUN_API=http://localhost:8088/cloudrun
CA_SECRETS_BACKEND=env
CA_SECRET_QUALITY_HASH_KEY=local-hash-key
CA_SECRET_MCP_CONTENT_ENCRYPTION_KEY=local-content-key
CA_SECRET_MCP_CONTENT_ENCRYPTION_SALT=local-content-salt
CA_JUDGE_BACKEND=fake
